{
  "routes": [
    { "route": "/services", "rewrite": "/services.html" },
    { "route": "/service-area", "rewrite": "/service-area.html" },
    { "route": "/insurance", "rewrite": "/insurance.html" },
    { "route": "/about", "rewrite": "/about.html" },
    { "route": "/contact", "rewrite": "/contact.html" }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["*.css", "*.js", "*.png", "*.jpg", "*.svg"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Cache-Control": "public, max-age=3600"
  }
}
