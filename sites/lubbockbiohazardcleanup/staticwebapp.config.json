{
  "routes": [
    { "route": "/services", "rewrite": "/services.html" },
    { "route": "/service-area", "rewrite": "/service-area.html" },
    { "route": "/insurance", "rewrite": "/insurance.html" },
    { "route": "/about", "rewrite": "/about.html" },
    { "route": "/contact", "rewrite": "/contact.html" },
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html",
      "statusCode": 404
    }
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["*.css", "*.js", "*.png", "*.jpg", "*.svg"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()",
    "Cache-Control": "public, max-age=0, must-revalidate"
  },
  "mimeTypes": {
    ".json": "application/json"
  }
}
